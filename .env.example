# Port for recommendation service
API_PORT=8080

# Dependency URLs (Docker internal networking)
USER_PROFILE_URL=http://user-profile-service:8081
CONTENT_URL=http://content-service:8082
TRENDING_URL=http://trending-service:8083

# Circuit Breaker Config
CB_TIMEOUT_SECONDS=2
CB_FAILURE_THRESHOLD=5
CB_FAILURE_RATE=0.5
CB_WINDOW_SIZE=10
CB_OPEN_DURATION=30
CB_HALF_OPEN_SUCCESS=3
